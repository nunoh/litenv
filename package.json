{
  "name": "use-litenv",
  "version": "0.2.0",
  "description": "Lightweight .env management, locally and over SSH",
  "author": "Nuno Hespanhol",
  "type": "module",
  "bin": {
    "litenv": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude='**/litenv-*/**' --test-coverage-exclude='test/**' --test-coverage-lines=98 --test-coverage-functions=95 --test-coverage-branches=85 test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "dotenv",
    "env",
    "ssh",
    "cli",
    "configuration",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nunoh/litenv.git"
  },
  "homepage": "https://github.com/nunoh/litenv#readme",
  "bugs": {
    "url": "https://github.com/nunoh/litenv/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
